# Local Docker services only. Replace these values on your machine.
POSTGRES_HOST=postgres
POSTGRES_USER=local_user
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=auction_house
PGADMIN_EMAIL=you@example.com
PGADMIN_PASSWORD=replace-with-a-local-password
MONGO_HOST=mongodb
MONGO_USER=local_user
MONGO_PASSWORD=replace-with-a-local-password
KAFKA_BROKER=kafka:29092
SESSION_SECRET=replace-with-a-long-random-local-secret
